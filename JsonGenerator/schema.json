{
  "tables": [
    {
      "table": "Users",
      "columns": [
        { "name": "Name", "type": "NVARCHAR(32)", "nullable": false },
        { "name": "Pw", "type": "NVARCHAR(32)", "nullable": false },
        { "name": "Type", "type": "NVARCHAR(10)", "nullable": false },
        { "name": "UID", "type": "BIGINT", "nullable": false }
      ],
      "primary_key": ["Name"]
    },
    {
      "table": "Name2UID",
      "columns": [
        { "name": "Name", "type": "NVARCHAR(32)", "nullable": false },
        { "name": "UID", "type": "BIGINT", "nullable": false }
      ],
      "primary_key": ["Name"]
    },
    {
      "table": "InventoryItems",
      "columns": [
        { "name": "CharacterUID", "type": "BIGINT", "nullable": false },
        { "name": "ItemID", "type": "INT", "nullable": false },
        { "name": "Count", "type": "INT", "nullable": false }
      ],
      "primary_key": ["CharacterUID", "ItemID"]
    }
  ],
  "procedures": [
    {
      "name": "UpsertInventoryItem",
      "params": [
        { "name": "CharacterUID", "type": "BIGINT" },
        { "name": "ItemID", "type": "INT" },
        { "name": "AddCount", "type": "INT" }
      ],
   "body": "IF EXISTS (SELECT 1 FROM InventoryItems WHERE CharacterUID = @CharacterUID AND ItemID = @ItemID)\nBEGIN\n    UPDATE InventoryItems SET Count = Count + @AddCount WHERE CharacterUID = @CharacterUID AND ItemID = @ItemID;\nEND\nELSE\nBEGIN\n    INSERT INTO InventoryItems (CharacterUID, ItemID, Count) VALUES (@CharacterUID, @ItemID, @AddCount);\nEND"
    }
  ]
}

